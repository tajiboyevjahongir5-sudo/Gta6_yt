# Railway: faqat shu 7 tasini kiriting. PORT, PUBLIC_URL va DATA_DIR avtomatik olinadi
# (domen: Settings -> Networking -> Generate Domain, disk: Volume, mount path /data).

BOT_TOKEN=                # @BotFather dan
ADMIN_IDS=                # Telegram ID(lar)ingiz, vergul bilan
WEBAPP_PASSWORD=          # panelni oddiy brauzerda ochish uchun parol (ixtiyoriy)
GOOGLE_CLIENT_ID=         # Google Cloud -> OAuth client (Web application)
GOOGLE_CLIENT_SECRET=
ANTHROPIC_API_KEY=        # AI: lahzalarni baholash, nom/tavsif/teg, brend (tavsiya)
SESSION_SECRET=           # istalgan uzun tasodifiy matn

