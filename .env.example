# Railway: shularni kiriting. AI uchun bittasi yetadi — bepul GEMINI_API_KEY. GOOGLE_* ni bo'sh qoldirsangiz ham bo'ladi — ularni Web App ichida
# (Sozlamalar -> YouTube'ni sozlash) kiritish qulayroq. PORT, PUBLIC_URL va DATA_DIR avtomatik olinadi
# (domen: Settings -> Networking -> Generate Domain, disk: Volume, mount path /data).

BOT_TOKEN=                # @BotFather dan
ADMIN_IDS=                # Telegram ID(lar)ingiz, vergul bilan
WEBAPP_PASSWORD=          # panelni oddiy brauzerda ochish uchun parol (ixtiyoriy)
GOOGLE_CLIENT_ID=         # ixtiyoriy: Web App ichida ham kiritiladi
GOOGLE_CLIENT_SECRET=
GEMINI_API_KEY=           # BEPUL AI: aistudio.google.com/apikey (Web App ichida ham kiritiladi)
ANTHROPIC_API_KEY=        # pullik AI (ixtiyoriy): Gemini limiti tugasa zaxira
SESSION_SECRET=           # istalgan uzun tasodifiy matn

# Faqat o'z serveringizda (Docker'siz) kerak bo'lishi mumkin — Railway'da QO'SHMANG:
# PUBLIC_URL=https://sizning-domen.com
# DATA_DIR=./data
# FONT_PATH=/path/to/Bold.ttf
# YTDLP_BIN=yt-dlp
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe

# Botga 20 MB dan katta (2 GB gacha) video yuborish uchun: my.telegram.org -> API development tools.
# Ixtiyoriy: botga "/tgapi API_ID API_HASH" deb yozsangiz ham bo'ladi
# TG_API_ID=
# TG_API_HASH=
